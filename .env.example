# Copy to .env and fill in the two required values. Never commit .env.

# Required
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=

# Optional
GROQ_MODEL=openai/gpt-oss-20b
SYSTEM_PROMPT=You are a friendly study buddy for software students. Keep answers short, concrete and encouraging.
MAX_HISTORY_MESSAGES=12
HISTORY_FILE=data/telegram_histories.json

# USD per 1,000,000 tokens, for the cost estimate in the logs.
# Check the current prices at https://groq.com/pricing
INPUT_PRICE_PER_MILLION_TOKENS=0.075
OUTPUT_PRICE_PER_MILLION_TOKENS=0.30

REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
